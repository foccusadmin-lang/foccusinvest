generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum PerfilUsuario {
  USUARIO
  LIDER
  ADMIN
  ENTIDADE
}

enum TipoEntidade {
  IGREJA
  ONG
  ASSOCIACAO
  INSTITUTO
  PROJETO_SOCIAL
  OUTRO
}

enum StatusEntidade {
  CADASTRO_INCOMPLETO
  AGUARDANDO_DOCUMENTOS
  EM_ANALISE
  AGUARDANDO_SALDO_ATIVACAO
  APROVADA
  ATIVA
  BLOQUEADA
  SUSPENSA
  INATIVA
}

enum TipoDoacao {
  SALDO_DISPONIVEL
  NOVA_APLICACAO
}

enum StatusDoacao {
  AGUARDANDO_PAGAMENTO
  EM_PROCESSAMENTO
  CONFIRMADA
  CANCELADA
  ESTORNADA
  EM_ANALISE
}

enum StatusCadastro {
  INCOMPLETO
  PENDENTE
  APROVADO
  SUSPENSO
  REJEITADO
}

enum OrigemAplicacao {
  NOVA_APLICACAO
  REAPLICACAO
  MIGRACAO
  AJUSTE_ADMIN
  DOACAO
}

enum StatusMigracao {
  PENDENTE
  SEM_DOCUMENTO
  AGUARDANDO_APROVACAO
  APLICADA
  CANCELADA
}

enum StatusAplicacao {
  AGUARDANDO_APROVACAO
  CONFIRMADA
  SAQUE_SOLICITADO
  RETIRADA
  REJEITADA
}

enum TipoCredito {
  RENDIMENTO
  BONUS
}

enum TipoSaque {
  CAPITAL
  RENDIMENTO
  BONUS
}

enum StatusSaque {
  SOLICITADO
  APROVADO
  PAGO
  RECUSADO
  CANCELADO
}

enum ModoProcessamento {
  MANUAL
  AUTOMATICO
}

enum StatusDistribuicao {
  ATIVA
  CANCELADA
}

enum TipoLiberacaoEmergencial {
  TOTAL
  PARCIAL
}

enum StatusLiberacaoEmergencial {
  ATIVA
  UTILIZADA
  EXPIRADA
  CANCELADA
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  perfil         PerfilUsuario  @default(USUARIO)
  tipoPessoa     TipoPessoa?
  statusCadastro StatusCadastro @default(INCOMPLETO)
  senha          String?
  tourConcluido  Boolean        @default(false)

  codigoIndicacao String? @unique
  indicadoPorId   String?
  indicadoPor     User?   @relation("Indicacoes", fields: [indicadoPorId], references: [id])
  indicados       User[]  @relation("Indicacoes")

  pessoaFisica   PessoaFisica?
  pessoaJuridica PessoaJuridica?
  aceites        TermoAceite[]
  logsAuditoria  LogAuditoria[]

  accounts             Account[]
  sessions             Session[]
  aplicacoes           Aplicacao[]
  aplicacoesAprovadas  Aplicacao[]                @relation("AplicacaoAprovadaPor")
  creditos             CreditoCarteira[]
  solicitacoesSaque    SolicitacaoSaque[]
  distribuicoesCriadas DistribuicaoMensal[]
  participacoes        DistribuicaoParticipante[]
  migracoesCriadas     MigracaoSaldo[]            @relation("MigracaoCriador")
  migracaoRecebida     MigracaoSaldo[]            @relation("MigracaoUsuario")
  contratos            Contrato[]

  entidade          Entidade?  @relation("EntidadeUsuario")
  entidadesAtivadas Entidade[] @relation("EntidadeAtivadaPor")
  doacoesFeitas     Doacao[]   @relation("DoacaoDoador")
  doacoesAprovadas  Doacao[]   @relation("DoacaoAprovadaPor")

  liberacoesEmergenciais           LiberacaoEmergencial[] @relation("LiberacaoEmergencialUsuario")
  liberacoesEmergenciaisCriadas    LiberacaoEmergencial[] @relation("LiberacaoEmergencialCriadaPor")
  liberacoesEmergenciaisCanceladas LiberacaoEmergencial[] @relation("LiberacaoEmergencialCanceladaPor")

  mensagensGuia MensagemGuia[]
  faqsGuiaCriadas FaqGuia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Perfil de igreja/ONG/associação/instituto/projeto social — sempre 1:1 com um User
 * (perfil: ENTIDADE), reaproveitando PessoaJuridica pra razão social/CNPJ/representante e a
 * carteira normal (Aplicacao/CreditoCarteira) pra saldo, extrato e saques, exatamente como um
 * investidor comum. Só guarda aqui o que é específico de entidade.
 */
model Entidade {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("EntidadeUsuario", fields: [userId], references: [id], onDelete: Cascade)

  tipoEntidade TipoEntidade
  descricao    String?
  logoUrl      String?
  cidade       String?
  estado       String?
  chavePix     String?

  status              StatusEntidade @default(CADASTRO_INCOMPLETO)
  documentosAprovados Boolean        @default(false)
  termosAceitos       Boolean        @default(false)
  taxaAtivacao        Float          @default(0)
  dataAtivacao        DateTime?
  ativadaPorId        String?
  ativadaPor          User?          @relation("EntidadeAtivadaPor", fields: [ativadaPorId], references: [id])

  podeReceberDoacao    Boolean @default(false)
  podeReceberAplicacao Boolean @default(false)

  doacoesRecebidas Doacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Doação de um investidor pra uma entidade — SALDO_DISPONIVEL debita na hora do saldo livre do
 * doador; NOVA_APLICACAO segue o mesmo fluxo de Pix + comprovante + aprovação do admin que uma
 * aplicação normal, só que o valor vai direto pra carteira da entidade, nunca pra do doador.
 */
model Doacao {
  id         String   @id @default(cuid())
  doadorId   String
  doador     User     @relation("DoacaoDoador", fields: [doadorId], references: [id], onDelete: Cascade)
  entidadeId String
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  tipoDoacao    TipoDoacao
  valorBruto    Float
  taxa          Float        @default(0)
  valorLiquido  Float
  origemSaldo   String?
  doacaoAnonima Boolean      @default(false)
  status        StatusDoacao @default(AGUARDANDO_PAGAMENTO)

  comprovante     Bytes?
  comprovanteNome String?
  comprovanteTipo String?

  aplicacaoId String? @unique

  aprovadoPorId String?
  aprovadoPor   User?     @relation("DoacaoAprovadaPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?
  motivoRecusa  String?

  criadoEm     DateTime  @default(now())
  confirmadoEm DateTime?
}

/**
 * Saldo trazido de outra plataforma (ex: Mocha) para um investidor que já tinha capital
 * investido lá. Lançado manualmente/via planilha pelo admin. Se o CPF/CNPJ ainda não tem conta
 * aqui, fica PENDENTE e é aplicado automaticamente assim que a pessoa completar o cadastro com
 * o mesmo documento.
 */
model MigracaoSaldo {
  id              String         @id @default(cuid())
  documento       String?        @unique
  nomeReferencia  String
  emailReferencia String?
  valor           Float
  valorPlr        Float          @default(0)
  valorBonus      Float          @default(0)
  observacao      String?
  status          StatusMigracao @default(PENDENTE)

  userId      String?
  user        User?   @relation("MigracaoUsuario", fields: [userId], references: [id])
  aplicacaoId String?

  criadoPorId String
  criadoPor   User   @relation("MigracaoCriador", fields: [criadoPorId], references: [id])

  criadoEm   DateTime  @default(now())
  aplicadoEm DateTime?
}

/**
 * Lançamento de resultado real do período, feito manualmente pelo admin como uma porcentagem
 * (ex: "julho deu 3%"). Cada investidor recebe esse mesmo percentual sobre o próprio capital,
 * e o sistema só dilui o pagamento em fatias diárias ao longo do período — o percentual em si
 * não muda depois de lançado.
 */
model DistribuicaoMensal {
  id               String             @id @default(cuid())
  periodoInicio    DateTime
  periodoFim       DateTime
  percentual       Float
  valorTotal       Float
  moeda            String             @default("BRL")
  resultadoApurado String
  observacoes      String?
  status           StatusDistribuicao @default(ATIVA)

  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())

  participantes DistribuicaoParticipante[]
}

/**
 * Cota de cada investidor numa distribuição, com o capital elegível já congelado no momento do
 * lançamento (não muda se o investidor aplicar mais depois) e o controle de quantos dias já foram
 * convertidos em crédito disponível.
 */
model DistribuicaoParticipante {
  id             String             @id @default(cuid())
  distribuicaoId String
  distribuicao   DistribuicaoMensal @relation(fields: [distribuicaoId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  capitalElegivel Float
  valorTotalCota  Float
  diasCreditados  Int   @default(0)

  @@unique([distribuicaoId, userId])
}

model Aplicacao {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  valor    Float
  moeda    String          @default("BRL")
  origem   OrigemAplicacao @default(NOVA_APLICACAO)
  status   StatusAplicacao @default(CONFIRMADA)
  criadoEm DateTime        @default(now())
  liberaEm DateTime

  comprovante     Bytes?
  comprovanteNome String?
  comprovanteTipo String?
  motivoRejeicao  String?

  aprovadoPorId String?
  aprovadoPor   User?     @relation("AplicacaoAprovadaPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?

  solicitacaoSaqueId String?
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])

  contrato               Contrato?
  liberacoesEmergenciais LiberacaoEmergencial[]
}

/**
 * Snapshot imutável do Contrato de Prestação de Serviços gerado no momento de cada aporte
 * (Nova Aplicação). Os dados são congelados na criação — não refletem edições posteriores
 * no perfil do investidor, preservando o documento tal como foi lido e confirmado.
 */
model Contrato {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aplicacaoId String    @unique
  aplicacao   Aplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)

  nome          String
  email         String
  cpf           String
  rg            String?
  nacionalidade String?
  estadoCivil   String?
  profissao     String?
  telefone      String?
  endereco      String?

  valor        Float
  valorExtenso String

  confirmouLeituraEm DateTime
  criadoEm           DateTime @default(now())
}

model CreditoCarteira {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo        TipoCredito
  valor       Float
  moeda       String      @default("BRL")
  origem      String
  criadoEm    DateTime    @default(now())
  utilizadoEm DateTime?

  solicitacaoSaqueId String?
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])
}

model SolicitacaoSaque {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo                TipoSaque
  valor               Float
  moeda               String      @default("BRL")
  status              StatusSaque @default(SOLICITADO)
  justificativaRecusa String?
  criadoEm            DateTime    @default(now())
  processadoEm        DateTime?

  emergencial                  Boolean @default(false)
  motivoEmergencia             String?
  valorBruto                   Float?
  taxaAntecipacao              Float?
  solicitacaoSaqueRendimentoId String?

  aplicacoes           Aplicacao[]
  creditos             CreditoCarteira[]
  liberacaoEmergencial LiberacaoEmergencial?
}

/**
 * Autorização individual, criada pelo admin, pra um investidor sacar um lote (Aplicacao)
 * específico antes do fim da carência — ignora o bloqueio normal de saque, mas só dentro do
 * valor máximo e prazo definidos. Usada uma única vez (ou até cancelada/expirar), e vinculada
 * ao SolicitacaoSaque gerado quando o investidor de fato usa a liberação.
 */
model LiberacaoEmergencial {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LiberacaoEmergencialUsuario", fields: [userId], references: [id], onDelete: Cascade)

  aplicacaoId String
  aplicacao   Aplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)

  valorMaximo Float
  tipoSaque   TipoLiberacaoEmergencial
  motivo      String
  expiraEm    DateTime

  status StatusLiberacaoEmergencial @default(ATIVA)

  criadoPorId String
  criadoPor   User     @relation("LiberacaoEmergencialCriadaPor", fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())
  ip          String?

  canceladoPorId String?
  canceladoPor   User?     @relation("LiberacaoEmergencialCanceladaPor", fields: [canceladoPorId], references: [id])
  canceladoEm    DateTime?

  solicitacaoSaqueId String?           @unique
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])
}

model PessoaFisica {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomeCompleto   String
  cpf            String   @unique
  dataNascimento DateTime
  telefone       String?
  endereco       String?
  rg             String?
  nacionalidade  String?
  estadoCivil    String?
  profissao      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PessoaJuridica {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  razaoSocial                String
  nomeFantasia               String?
  cnpj                       String   @unique
  representanteLegal         String
  cpfRepresentante           String
  telefone                   String?
  endereco                   String?
  rgRepresentante            String?
  nacionalidadeRepresentante String?
  estadoCivilRepresentante   String?
  profissaoRepresentante     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model TermoAceite {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String
  versao   String
  aceitoEm DateTime @default(now())
  ip       String?
}

model ConfiguracaoSistema {
  id                      String            @id @default("default")
  modoSaqueCapital        ModoProcessamento @default(MANUAL)
  modoSaqueRendimento     ModoProcessamento @default(MANUAL)
  modoVerificacaoCadastro ModoProcessamento @default(MANUAL)
  modoIncentivoLideranca  ModoProcessamento @default(MANUAL)
  updatedAt               DateTime          @updatedAt
}

model LogAuditoria {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  acao      String
  detalhes  String?
  ip        String?
  createdAt DateTime @default(now())
}

enum PapelMensagemGuia {
  USER
  MODEL
}

/** Histórico persistido de cada mensagem trocada com o Guia Foccus (assistente Gemini) — dá
 *  continuidade ao chat entre sessões e é a base pra identificar dúvidas recorrentes (mesmo
 *  tópico perguntado várias vezes) e pro admin acompanhar as perguntas mais frequentes. */
model MensagemGuia {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel    PapelMensagemGuia
  texto    String
  topico   String?
  criadoEm DateTime          @default(now())

  @@index([userId, criadoEm])
  @@index([topico])
}

/** FAQ curada pelo admin — respostas fixas por tópico que o admin revisa a partir das perguntas
 *  mais frequentes (ver /restrito/guia) e que entram no contexto do Gemini, pra padronizar a
 *  resposta de dúvidas recorrentes em vez de depender só do que o modelo geraria sozinho. */
model FaqGuia {
  id          String   @id @default(cuid())
  topico      String
  pergunta    String
  resposta    String
  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
