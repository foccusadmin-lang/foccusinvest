generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum PerfilUsuario {
  USUARIO
  LIDER
  ADMIN
  ENTIDADE
  // Carteira interna da empresa (WD Insight Rodrigues Soluções e Consultoria LTDA,
  // codigoIndicacao "2VPDV-GRUPO") que recebe as tarifas de Pacotes de Serviços — reaproveita a
  // mesma carteira normal (Aplicacao/CreditoCarteira) de qualquer usuário, só pra registrar o
  // capital recebido; nunca faz login nem aparece em listagens de investidor.
  EMPRESA
}

enum TipoEntidade {
  IGREJA
  ONG
  ASSOCIACAO
  INSTITUTO
  PROJETO_SOCIAL
  OUTRO
}

enum StatusEntidade {
  CADASTRO_INCOMPLETO
  AGUARDANDO_DOCUMENTOS
  EM_ANALISE
  AGUARDANDO_SALDO_ATIVACAO
  APROVADA
  ATIVA
  BLOQUEADA
  SUSPENSA
  INATIVA
}

enum TipoDoacao {
  SALDO_DISPONIVEL
  NOVA_APLICACAO
}

enum StatusDoacao {
  AGUARDANDO_PAGAMENTO
  EM_PROCESSAMENTO
  CONFIRMADA
  CANCELADA
  ESTORNADA
  EM_ANALISE
}

enum StatusCadastro {
  INCOMPLETO
  PENDENTE
  APROVADO
  SUSPENSO
  REJEITADO
}

enum OrigemAplicacao {
  NOVA_APLICACAO
  REAPLICACAO
  // Mesma coisa que REAPLICACAO, só que lançada sozinha pelo sistema (reaplicação automática
  // ligada pelo investidor) em vez de um clique manual em "Reaplicar agora" — só pra aparecer
  // rotulada certo no histórico (ver reaplicarAutomaticamenteSeNecessario, em lib/carteira.ts).
  REAPLICACAO_AUTOMATICA
  MIGRACAO
  AJUSTE_ADMIN
  DOACAO
  // Capital movido de um investidor pra outro pelo admin (ver transferirCapitalEntreUsuarios,
  // em lib/carteira.ts) — só marca o lote criado pro lado que RECEBE; o lado que envia só tem
  // o capital reduzido (mesmo padrão do ajuste manual "Apagar"), sem registro próprio.
  TRANSFERENCIA
  // Capital movido entre dois investidores pelo serviço "Transferência entre usuários" (pago,
  // do Pacote de Serviços) — mesma mecânica de TRANSFERENCIA, só separado no histórico pra
  // distinguir uma transferência que o próprio investidor fez de uma feita pelo admin.
  TRANSFERENCIA_ENTRE_USUARIOS
  // Marca o lote de capital recebido pela carteira interna da empresa (User perfil EMPRESA)
  // como pagamento de tarifa de serviço — ver lib/servicos-contratacao.ts.
  PAGAMENTO_SERVICO
}

enum CategoriaBem {
  IMOVEL
  AUTOMOVEL
  ELETRONICO
}

enum StatusMigracao {
  PENDENTE
  SEM_DOCUMENTO
  AGUARDANDO_APROVACAO
  APLICADA
  CANCELADA
}

enum StatusAplicacao {
  AGUARDANDO_APROVACAO
  CONFIRMADA
  SAQUE_SOLICITADO
  RETIRADA
  REJEITADA
}

enum TipoCredito {
  RENDIMENTO
  BONUS
}

enum TipoSaque {
  CAPITAL
  RENDIMENTO
  BONUS
}

enum StatusSaque {
  SOLICITADO
  AGUARDANDO_PAGAMENTO
  PAGO
  RECUSADO
  CANCELADO
}

/** Tipo da chave Pix informada pelo investidor no saque — escolhido explicitamente por ele no
 *  formulário (não adivinhado a partir do valor), pra nunca gerar QR Code com chave ambígua. */
enum TipoChavePix {
  TELEFONE
  CPF
  CNPJ
  EMAIL
  ALEATORIA
}

enum ModoProcessamento {
  MANUAL
  AUTOMATICO
}

enum StatusDistribuicao {
  ATIVA
  CANCELADA
}

enum TipoLiberacaoEmergencial {
  TOTAL
  PARCIAL
}

enum StatusLiberacaoEmergencial {
  ATIVA
  UTILIZADA
  EXPIRADA
  CANCELADA
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  perfil         PerfilUsuario  @default(USUARIO)
  tipoPessoa     TipoPessoa?
  statusCadastro StatusCadastro @default(INCOMPLETO)
  senha          String?
  tourConcluido  Boolean        @default(false)
  // Modal de convite pro Grupo Foccus (WhatsApp) — mostrado uma única vez; marcado como visto
  // tanto ao clicar em "Acessar grupo" quanto ao fechar a janela (ver GrupoFoccusModal).
  viuGrupoFoccus Boolean        @default(false)
  // Se true, sempre que o saldo disponível pra reaplicar (rendimento + bônus) atingir o mínimo
  // (R$100), reaplica sozinho — sem esperar o investidor clicar em "Reaplicar agora" (ver
  // reaplicarAutomaticamenteSeNecessario, em lib/carteira.ts).
  reaplicacaoAutomatica Boolean @default(false)

  codigoIndicacao String? @unique
  indicadoPorId   String?
  indicadoPor     User?   @relation("Indicacoes", fields: [indicadoPorId], references: [id])
  indicados       User[]  @relation("Indicacoes")

  pessoaFisica   PessoaFisica?
  pessoaJuridica PessoaJuridica?
  aceites        TermoAceite[]
  logsAuditoria  LogAuditoria[]

  accounts             Account[]
  sessions             Session[]
  aplicacoes           Aplicacao[]
  aplicacoesAprovadas  Aplicacao[]                @relation("AplicacaoAprovadaPor")
  creditos             CreditoCarteira[]
  solicitacoesSaque    SolicitacaoSaque[]
  saquesProcessados    SolicitacaoSaque[]         @relation("SaqueProcessadoPor")
  distribuicoesCriadas DistribuicaoMensal[]
  participacoes        DistribuicaoParticipante[]
  migracoesCriadas     MigracaoSaldo[]            @relation("MigracaoCriador")
  migracaoRecebida     MigracaoSaldo[]            @relation("MigracaoUsuario")
  contratos            Contrato[]

  entidade          Entidade?  @relation("EntidadeUsuario")
  entidadesAtivadas Entidade[] @relation("EntidadeAtivadaPor")
  doacoesFeitas     Doacao[]   @relation("DoacaoDoador")
  doacoesAprovadas  Doacao[]   @relation("DoacaoAprovadaPor")

  liberacoesEmergenciais           LiberacaoEmergencial[] @relation("LiberacaoEmergencialUsuario")
  liberacoesEmergenciaisCriadas    LiberacaoEmergencial[] @relation("LiberacaoEmergencialCriadaPor")
  liberacoesEmergenciaisCanceladas LiberacaoEmergencial[] @relation("LiberacaoEmergencialCanceladaPor")

  mensagensGuia MensagemGuia[]
  faqsGuiaCriadas FaqGuia[]

  contratosServico  ContratoServico[]
  servicosLiberados ContratoServico[] @relation("ServicoLiberadoPor")
  cobrancasServico  CobrancaServico[]
  benchmarksCriados BenchmarkMercado[]
  campanhasPlrCriadas CampanhaPlrAutomatica[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Perfil de igreja/ONG/associação/instituto/projeto social — sempre 1:1 com um User
 * (perfil: ENTIDADE), reaproveitando PessoaJuridica pra razão social/CNPJ/representante e a
 * carteira normal (Aplicacao/CreditoCarteira) pra saldo, extrato e saques, exatamente como um
 * investidor comum. Só guarda aqui o que é específico de entidade.
 */
model Entidade {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("EntidadeUsuario", fields: [userId], references: [id], onDelete: Cascade)

  tipoEntidade TipoEntidade
  descricao    String?
  logoUrl      String?
  cidade       String?
  estado       String?
  chavePix     String?

  status              StatusEntidade @default(CADASTRO_INCOMPLETO)
  documentosAprovados Boolean        @default(false)
  termosAceitos       Boolean        @default(false)
  taxaAtivacao        Float          @default(0)
  dataAtivacao        DateTime?
  ativadaPorId        String?
  ativadaPor          User?          @relation("EntidadeAtivadaPor", fields: [ativadaPorId], references: [id])

  podeReceberDoacao    Boolean @default(false)
  podeReceberAplicacao Boolean @default(false)

  doacoesRecebidas Doacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Doação de um investidor pra uma entidade — SALDO_DISPONIVEL debita na hora do saldo livre do
 * doador; NOVA_APLICACAO segue o mesmo fluxo de Pix + comprovante + aprovação do admin que uma
 * aplicação normal, só que o valor vai direto pra carteira da entidade, nunca pra do doador.
 */
model Doacao {
  id         String   @id @default(cuid())
  doadorId   String
  doador     User     @relation("DoacaoDoador", fields: [doadorId], references: [id], onDelete: Cascade)
  entidadeId String
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  tipoDoacao    TipoDoacao
  valorBruto    Float
  taxa          Float        @default(0)
  valorLiquido  Float
  origemSaldo   String?
  doacaoAnonima Boolean      @default(false)
  status        StatusDoacao @default(AGUARDANDO_PAGAMENTO)

  comprovante     Bytes?
  comprovanteNome String?
  comprovanteTipo String?

  aplicacaoId String? @unique

  aprovadoPorId String?
  aprovadoPor   User?     @relation("DoacaoAprovadaPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?
  motivoRecusa  String?

  criadoEm     DateTime  @default(now())
  confirmadoEm DateTime?
}

/**
 * Saldo trazido de outra plataforma (ex: Mocha) para um investidor que já tinha capital
 * investido lá. Lançado manualmente/via planilha pelo admin. Se o CPF/CNPJ ainda não tem conta
 * aqui, fica PENDENTE e é aplicado automaticamente assim que a pessoa completar o cadastro com
 * o mesmo documento.
 */
model MigracaoSaldo {
  id              String         @id @default(cuid())
  documento       String?        @unique
  nomeReferencia  String
  emailReferencia String?
  valor           Float
  valorPlr        Float          @default(0)
  valorBonus      Float          @default(0)
  observacao      String?
  status          StatusMigracao @default(PENDENTE)

  userId      String?
  user        User?   @relation("MigracaoUsuario", fields: [userId], references: [id])
  aplicacaoId String?

  criadoPorId String
  criadoPor   User   @relation("MigracaoCriador", fields: [criadoPorId], references: [id])

  criadoEm   DateTime  @default(now())
  aplicadoEm DateTime?
}

/**
 * Lançamento de resultado real do período, feito manualmente pelo admin como uma porcentagem
 * (ex: "julho deu 3%"). Cada investidor recebe esse mesmo percentual sobre o próprio capital,
 * e o sistema só dilui o pagamento em fatias diárias ao longo do período — o percentual em si
 * não muda depois de lançado.
 */
model DistribuicaoMensal {
  id               String             @id @default(cuid())
  periodoInicio    DateTime
  periodoFim       DateTime
  percentual       Float
  valorTotal       Float
  moeda            String             @default("BRL")
  resultadoApurado String
  observacoes      String?
  status           StatusDistribuicao @default(ATIVA)

  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())

  participantes DistribuicaoParticipante[]
  // Presente só quando esta Distribuição foi gerada sozinha pelo motor de PLR automático (um
  // dia = uma Distribuição de um dia só) — null quando foi lançada manualmente pelo admin.
  campanhaPlrDia CampanhaPlrDia?
}

/**
 * Cota de cada investidor numa distribuição, com o capital elegível já congelado no momento do
 * lançamento (não muda se o investidor aplicar mais depois) e o controle de quantos dias já foram
 * convertidos em crédito disponível.
 */
model DistribuicaoParticipante {
  id             String             @id @default(cuid())
  distribuicaoId String
  distribuicao   DistribuicaoMensal @relation(fields: [distribuicaoId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  capitalElegivel Float
  valorTotalCota  Float
  diasCreditados  Int   @default(0)

  @@unique([distribuicaoId, userId])
}

model Aplicacao {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  valor    Float
  moeda    String          @default("BRL")
  origem   OrigemAplicacao @default(NOVA_APLICACAO)
  status   StatusAplicacao @default(CONFIRMADA)
  criadoEm DateTime        @default(now())
  liberaEm DateTime

  comprovante     Bytes?
  comprovanteNome String?
  comprovanteTipo String?
  comprovanteHash String?
  motivoRejeicao  String?

  // Preenchido quando esse aporte bate com outro já existente do mesmo investidor (mesmo valor
  // + mesmo comprovante, via comprovanteHash) — guarda o id do aporte original. Nesse caso o
  // aporte nunca é confirmado automaticamente, mesmo com o modo automático ligado: fica retido
  // pra conferência manual do admin (ver criarAplicacao, painel/actions.ts).
  aporteDuplicadoDeId String?

  // Aporte em bens (imóvel/automóvel/eletrônico) — preenchidos só nesse caso. O valor "oficial"
  // (campo `valor` acima) começa igual a valorDeclarado e só é confirmado/ajustado pelo admin
  // depois de avaliar o bem entregue (ver aprovarAporte com ajusteBem).
  categoriaBem    CategoriaBem?
  descricaoBem    String?
  valorDeclarado  Float?
  dataAgendamento DateTime?

  aprovadoPorId String?
  aprovadoPor   User?     @relation("AplicacaoAprovadaPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?

  solicitacaoSaqueId String?
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])

  contrato               Contrato?
  liberacoesEmergenciais LiberacaoEmergencial[]

  @@index([userId, valor, comprovanteHash])
}

/**
 * Snapshot imutável do Contrato de Prestação de Serviços gerado no momento de cada aporte
 * (Nova Aplicação). Os dados são congelados na criação — não refletem edições posteriores
 * no perfil do investidor, preservando o documento tal como foi lido e confirmado.
 */
model Contrato {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aplicacaoId String    @unique
  aplicacao   Aplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)

  nome          String
  email         String
  cpf           String
  rg            String?
  nacionalidade String?
  estadoCivil   String?
  profissao     String?
  telefone      String?
  endereco      String?

  valor        Float
  valorExtenso String

  confirmouLeituraEm DateTime
  criadoEm           DateTime @default(now())
}

model CreditoCarteira {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo        TipoCredito
  valor       Float
  moeda       String      @default("BRL")
  origem      String
  criadoEm    DateTime    @default(now())
  utilizadoEm DateTime?

  solicitacaoSaqueId String?
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])
}

model SolicitacaoSaque {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo                TipoSaque
  valor               Float
  moeda               String      @default("BRL")
  status              StatusSaque @default(SOLICITADO)
  justificativaRecusa String?
  criadoEm            DateTime    @default(now())
  processadoEm        DateTime?

  emergencial                  Boolean @default(false)
  motivoEmergencia             String?
  valorBruto                   Float?
  taxaAntecipacao              Float?
  solicitacaoSaqueRendimentoId String?

  // Snapshot do investidor no momento da solicitação (nome/e-mail podem mudar depois no
  // cadastro; isso preserva exatamente quem pediu, pro comprovante/QR Code e pra auditoria).
  investidorNome  String?
  investidorEmail String?

  // Chave Pix informada pelo investidor — original (como digitado) e normalizada (padrão que
  // entra no QR Code/payload), nunca alteráveis depois de geradas: pra corrigir, cancela essa
  // solicitação (RECUSADO/CANCELADO) e abre uma nova.
  chavePixOriginal    String?
  chavePixNormalizada String?
  chavePixTipo        TipoChavePix?

  // Pix Copia e Cola (BR Code/EMV) + PNG do QR Code gerado a partir dele + TXID único —
  // gerados uma única vez, na criação da solicitação, e nunca recalculados depois.
  pixPayload String?
  pixQrCodePng Bytes?
  pixTxid      String? @unique

  // Sexta-feira programada pra esse pagamento (calculada na criação, regra configurável — ver
  // ConfiguracaoSistema.saquePagaMesmaSexta) e quando de fato foi pago.
  dataProgramadaPagamento DateTime?
  pagoEm                  DateTime?

  // Chave de idempotência enviada pelo formulário — bloqueia duplicidade por clique repetido/
  // reenvio de rede (ver criarSolicitacaoSaquePix, em lib/saque-pix.ts).
  idempotencyKey String? @unique

  // Quem aprovou/recusou/marcou como pago por último — o histórico detalhado de cada ação (com
  // timestamp e IP) já fica em LogAuditoria; este campo é só o atalho pra exibir na tela.
  processadoPorId String?
  processadoPor   User?   @relation("SaqueProcessadoPor", fields: [processadoPorId], references: [id])

  aplicacoes           Aplicacao[]
  creditos             CreditoCarteira[]
  liberacaoEmergencial LiberacaoEmergencial?
}

/**
 * Autorização individual, criada pelo admin, pra um investidor sacar um lote (Aplicacao)
 * específico antes do fim da carência — ignora o bloqueio normal de saque, mas só dentro do
 * valor máximo e prazo definidos. Usada uma única vez (ou até cancelada/expirar), e vinculada
 * ao SolicitacaoSaque gerado quando o investidor de fato usa a liberação.
 */
model LiberacaoEmergencial {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LiberacaoEmergencialUsuario", fields: [userId], references: [id], onDelete: Cascade)

  aplicacaoId String
  aplicacao   Aplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)

  valorMaximo Float
  tipoSaque   TipoLiberacaoEmergencial
  motivo      String
  expiraEm    DateTime

  status StatusLiberacaoEmergencial @default(ATIVA)

  criadoPorId String
  criadoPor   User     @relation("LiberacaoEmergencialCriadaPor", fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())
  ip          String?

  canceladoPorId String?
  canceladoPor   User?     @relation("LiberacaoEmergencialCanceladaPor", fields: [canceladoPorId], references: [id])
  canceladoEm    DateTime?

  solicitacaoSaqueId String?           @unique
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])
}

model PessoaFisica {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomeCompleto   String
  cpf            String   @unique
  dataNascimento DateTime
  telefone       String?
  endereco       String?
  rg             String?
  nacionalidade  String?
  estadoCivil    String?
  profissao      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PessoaJuridica {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  razaoSocial                String
  nomeFantasia               String?
  cnpj                       String   @unique
  representanteLegal         String
  cpfRepresentante           String
  telefone                   String?
  endereco                   String?
  rgRepresentante            String?
  nacionalidadeRepresentante String?
  estadoCivilRepresentante   String?
  profissaoRepresentante     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model TermoAceite {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String
  versao   String
  aceitoEm DateTime @default(now())
  ip       String?
}

/**
 * Vitrine de operação exibida no painel do investidor — mostra a estratégia de operação atual
 * (moedas trabalhadas, resultado acumulado, comparativo ao longo do tempo). É só uma vitrine
 * informativa/institucional, mantida pelo admin — não tem relação com o capital nem o PLR real
 * de cada investidor.
 */
model EstrategiaOperacao {
  id           String   @id @default(cuid())
  nome         String   @default("Estratégia WEM")
  moedas       String   @default("USD, EUR, XAU (Ouro)")
  esperadoMin  Float    @default(1.5)
  esperadoMax  Float    @default(4.0)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pontos PontoEstrategia[]
}

/** Variação percentual de um dia específico da estratégia — a soma acumulada desses pontos (em
 *  ordem cronológica) é o que forma o gráfico "Comparativo" e o "Acumulado" da vitrine. */
model PontoEstrategia {
  id           String             @id @default(cuid())
  estrategiaId String
  estrategia   EstrategiaOperacao @relation(fields: [estrategiaId], references: [id], onDelete: Cascade)
  data         DateTime
  variacaoDia  Float
  criadoEm     DateTime           @default(now())

  @@unique([estrategiaId, data])
  @@index([estrategiaId, data])
}

model ConfiguracaoSistema {
  id                      String            @id @default("default")
  modoSaqueCapital        ModoProcessamento @default(MANUAL)
  modoSaqueRendimento     ModoProcessamento @default(MANUAL)
  modoVerificacaoCadastro ModoProcessamento @default(MANUAL)
  modoIncentivoLideranca  ModoProcessamento @default(MANUAL)
  modoBonusIndicacao      ModoProcessamento @default(MANUAL)
  modoAprovacaoAporte     ModoProcessamento @default(MANUAL)
  // Teto de valor pra um aporte via Pix se qualificar pra aprovação automática — acima disso,
  // mesmo com o modo Automático ligado, cai pra conferência manual do admin.
  valorMaximoAprovacaoAutomatica Float      @default(5000)
  // Liga/desliga o botão de Aplicação em bens (imóvel/automóvel/eletrônico) pro investidor. Com
  // false, o botão continua visível mas, ao clicar, mostra um aviso pra falar com o admin em
  // vez de abrir o formulário — não afeta aportes em bens já em andamento.
  aplicacaoBensAtiva      Boolean           @default(true)
  // Cidade usada no campo "Merchant City" do QR Code Pix gerado pros saques dos investidores.
  cidadePagamentoPix String  @default("JANDIRA")
  // Se a solicitação de saque cair numa sexta-feira, decide se a data programada de pagamento
  // é aquela mesma sexta (true) ou a sexta seguinte (false).
  saquePagaMesmaSexta Boolean @default(true)
  // Manual: admin continua lançando cada Distribuição na mão, como sempre (ver
  // /restrito/distribuicoes). Automático: usa a campanha ativa em CampanhaPlrAutomatica pra
  // gerar uma Distribuição por dia sozinho (ver lib/plr-automatico.ts).
  modoPLR                 ModoProcessamento @default(MANUAL)
  updatedAt               DateTime          @updatedAt
}

model LogAuditoria {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  acao      String
  detalhes  String?
  ip        String?
  createdAt DateTime @default(now())
}

enum PapelMensagemGuia {
  USER
  MODEL
}

/** Histórico persistido de cada mensagem trocada com o Guia Foccus (assistente Gemini) — dá
 *  continuidade ao chat entre sessões e é a base pra identificar dúvidas recorrentes (mesmo
 *  tópico perguntado várias vezes) e pro admin acompanhar as perguntas mais frequentes. */
model MensagemGuia {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel    PapelMensagemGuia
  texto    String
  topico   String?
  criadoEm DateTime          @default(now())

  @@index([userId, criadoEm])
  @@index([topico])
}

/** FAQ curada pelo admin — respostas fixas por tópico que o admin revisa a partir das perguntas
 *  mais frequentes (ver /restrito/guia) e que entram no contexto do Gemini, pra padronizar a
 *  resposta de dúvidas recorrentes em vez de depender só do que o modelo geraria sozinho. */
model FaqGuia {
  id          String   @id @default(cuid())
  topico      String
  pergunta    String
  resposta    String
  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================================
// PACOTES DE SERVIÇOS — catálogo, contratos por usuário e cobranças.
// =====================================================================================

enum CodigoServico {
  TRANSFERENCIA_USUARIOS
  REAPLICACAO_AUTOMATICA
  ASSESSORIA_CONTABIL
  ASSESSORIA_JURIDICA
  ASSESSORIA_TI
  APLICACAO_BENS
  DOAR_ENTIDADE
  PLANO_LIDERANCA
  // Serviço adicional (fora dos 8 originais do pacote completo — não entra no cálculo de
  // desconto de 5%/R$ 50,00) — contratar deixa o usuário elegível a receber uma liberação de
  // saque de emergência do admin (ver lib/emergencia.ts); sem o serviço ATIVO, o admin não
  // consegue criar a liberação.
  SAQUE_EMERGENCIA
}

/** Estados possíveis de um serviço pra um usuário específico (seção 8 do documento). */
enum StatusServicoUsuario {
  DISPONIVEL
  SELECIONADO
  AGUARDANDO_CONFIRMACAO
  PAGAMENTO_PENDENTE
  CONTRATADO
  CONTRATADO_AGUARDANDO_ELEGIBILIDADE
  ATIVO
  INATIVO
  DESATIVACAO_AGENDADA
  BLOQUEADO
  SUSPENSO
  CANCELADO
  PAGAMENTO_RECUSADO
  ERRO_PAGAMENTO
}

enum FormaContratacaoServico {
  INDIVIDUAL
  PACOTE_MENSAL
  PACOTE_ANUAL
}

enum StatusCobrancaServico {
  PENDENTE
  CONFIRMADA
  RECUSADA
  CANCELADA
  ESTORNADA
  DUPLICADA
  ERRO
}

/** Catálogo — um registro por serviço, sempre cadastrado e ativo internamente (o que fica
 *  oculto/bloqueado pro usuário é o CONTRATO dele, não o catálogo). */
model ServicoPacote {
  id            String        @id @default(cuid())
  codigo        CodigoServico @unique
  nome          String
  descricao     String
  // Tarifa unitária mensal — usada tanto na contratação individual (integral) quanto somada
  // no subtotal do pacote completo (com desconto).
  tarifa        Float
  // Preço próprio quando contratado avulso no plano anual (não simplesmente tarifa*12) — só
  // usado fora do pacote completo; o pacote completo anual usa PRECO_PACOTE_ANUAL fixo.
  icone         String?
  ordem         Int           @default(0)
  integraPacote Boolean       @default(true)
  ativoGlobal   Boolean       @default(true)
  // Contato/mensagem das assessorias (Contábil/Jurídica vêm com valor fixo já semeado;
  // TI fica em branco até o admin configurar — nunca inventado).
  contatoWhatsapp String?
  mensagemPadrao  String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contratos ContratoServico[]
}

/** Status individual do serviço pra cada usuário — o que de fato controla se a funcionalidade
 *  aparece/funciona pra ele (seção 1 e 7 do documento). Preserva todo o histórico: nunca é
 *  apagado, só muda de status. */
model ContratoServico {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicoId String
  servico   ServicoPacote         @relation(fields: [servicoId], references: [id])
  status    StatusServicoUsuario  @default(INATIVO)

  formaContratacao FormaContratacaoServico?
  contratadoEm     DateTime?
  ativadoEm        DateTime?
  desativadoEm     DateTime?
  // Fim da vigência (pacote mensal/anual) — informativo; não gera cancelamento/estorno
  // automático (documento proíbe isso sem regra definida pelo admin).
  vigenciaFim      DateTime?

  // Plano de Liderança: liberação excepcional pelo admin antes da meta de 30 indicados.
  liberacaoExcepcional Boolean   @default(false)
  liberadoPorId        String?
  liberadoPor          User?     @relation("ServicoLiberadoPor", fields: [liberadoPorId], references: [id])
  motivoLiberacao      String?
  liberadoEm           DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([userId, servicoId])
}

/**
 * Registro financeiro de cada cobrança de serviço (individual ou pacote) — nunca apagado,
 * mesmo que o(s) serviço(s) sejam desativados depois. Um único registro por contratação, ainda
 * que envolva vários serviços (pacote completo).
 */
model CobrancaServico {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Códigos dos serviços incluídos nesta cobrança, em JSON (ex: '["ASSESSORIA_TI"]').
  servicosCodigos  String
  formaContratacao FormaContratacaoServico

  valorBruto         Float
  percentualDesconto Float @default(0)
  valorDesconto      Float @default(0)
  valorFinal         Float

  // De onde saiu o valor — rendimento/bônus primeiro, capital só se faltar (mesma prioridade
  // de reaplicarSaldoDisponivel).
  origemRendimento Float @default(0)
  origemBonus      Float @default(0)
  origemCapital    Float @default(0)

  carteiraDestinoNome  String @default("WD INSIGHT RODRIGUES SOLUCOES E CONSULTORIA LTDA")
  codigoCarteiraDestino String @default("2VPDV-GRUPO")

  status         StatusCobrancaServico @default(CONFIRMADA)
  idempotencyKey String?               @unique
  txid           String                @unique

  criadoEm    DateTime  @default(now())
  processadoEm DateTime?
}

// =====================================================================================
// RENTABILIDADE VS ÍNDICES — comparativo factual entre a rentabilidade realmente distribuída
// (DistribuicaoMensal.percentual, já existente) e índices de mercado inseridos manualmente
// pelo admin (sem integração com API de mercado). Só dado histórico realizado — nenhuma meta,
// nenhuma promessa de retorno futuro.
// =====================================================================================

enum IndicadorMercado {
  CDI
  CDB
  IPCA
  IBOVESPA
}

/** Valor mensal de um índice de mercado, lançado manualmente pelo admin — não há integração
 *  automática com nenhuma fonte de mercado. Um valor por índice por mês. */
model BenchmarkMercado {
  id              String           @id @default(cuid())
  indicador       IndicadorMercado
  // Sempre o primeiro dia do mês (ex: 2026-08-01) — mesma convenção de "period bucket" usada
  // pra agrupar DistribuicaoMensal por mês no comparativo.
  mes             DateTime
  valorPercentual Float

  criadoPorId String
  criadoPor   User   @relation(fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([indicador, mes])
}

// =====================================================================================
// PLR AUTOMÁTICO — quando ConfiguracaoSistema.modoPLR = AUTOMATICO, o admin define um
// percentual total + período + horário de lançamento diário, e o sistema gera sozinho uma
// Distribuição por dia (ver lib/plr-automatico.ts), reaproveitando 100% do motor de
// Distribuição/diluição diária que já existe pro lançamento manual.
// =====================================================================================

/** Uma "campanha" = um percentual total definido pelo admin, distribuído de forma variada ao
 *  longo dos dias do período (mais nas sextas, menos nos fins de semana) — o cronograma inteiro
 *  (CampanhaPlrDia) já é sorteado e gravado na criação, garantindo que a soma bata exatamente
 *  com percentualTotal. Só uma campanha fica "ativa" por vez. */
model CampanhaPlrAutomatica {
  id                String   @id @default(cuid())
  percentualTotal   Float
  periodoInicio     DateTime
  periodoFim        DateTime
  // Horário (Brasília, "HH:MM") a partir do qual o dia fica liberado pra ser lançado — o motor
  // só materializa a Distribuição daquele dia depois desse horário (ver processarDiasPendentes).
  horarioLancamento String
  ativa             Boolean  @default(true)

  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())

  dias CampanhaPlrDia[]
}

/** Um dia do cronograma de uma campanha — o percentual de cada dia já é sorteado (dentro da
 *  faixa do tipo de dia: seg-qui, sexta ou fim de semana) no momento da criação da campanha,
 *  nunca recalculado depois. `processadoEm`/`distribuicaoId` só são preenchidos quando o motor
 *  automático de fato gera a Distribuição daquele dia. */
model CampanhaPlrDia {
  id         String                @id @default(cuid())
  campanhaId String
  campanha   CampanhaPlrAutomatica @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  data       DateTime
  percentual Float

  processadoEm   DateTime?
  distribuicaoId String?             @unique
  distribuicao   DistribuicaoMensal? @relation(fields: [distribuicaoId], references: [id])

  @@unique([campanhaId, data])
}

/** Marcador de "incentivo de liderança automático já reivindicado nesse dia" — existir a linha
 *  (não o conteúdo dela) é o que importa. `dia` é único, então só UMA chamada concorrente
 *  consegue criar o marcador pra um dia; as demais recebem violação de unicidade (P2002) e
 *  desistem sem duplicar (ver liberarIncentivoAutomaticoSeNecessario, em
 *  lib/incentivo-lideranca.ts) — mesma proteção que CampanhaPlrDia dá pro PLR automático. */
model LiberacaoIncentivoDiaria {
  id       String   @id @default(cuid())
  dia      DateTime @unique
  criadoEm DateTime @default(now())
}
